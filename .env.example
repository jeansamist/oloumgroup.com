# Public URL of the site (canonical URLs, sitemap, Open Graph images, JSON-LD).
# Leave unset on Vercel: the project's production domain (or the preview URL) is used automatically.
# Set it to https://www.oloumgroup.com once the client's domain points to this site.
NEXT_PUBLIC_SITE_URL=
# Set to "true" to block indexing (Vercel preview deployments are blocked automatically)
NEXT_PUBLIC_NOINDEX=false
